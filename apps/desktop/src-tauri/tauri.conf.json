{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnYC",
  "version": "../package.json",
  "identifier": "io.github.brobit.knyc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KnYC",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Alann Maricourt",
    "copyright": "© 2026 Alann Maricourt — GPL-3.0",
    "license": "GPL-3.0-only",
    "category": "DeveloperTool",
    "shortDescription": "Know your code",
    "longDescription": "Import any project and rebuild it step by step, with an AI guide and real checks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
