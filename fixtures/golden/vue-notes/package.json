{
  "name": "vue-notes",
  "version": "1.0.0",
  "private": true,
  "description": "A notes app in Vue 3 (Vite): single-file components, a Pinia store kept in the browser, and vue-router pages (KnYC golden fixture).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.14"
  }
}
