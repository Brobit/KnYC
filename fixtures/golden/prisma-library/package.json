{
  "name": "prisma-library",
  "version": "1.0.0",
  "private": true,
  "description": "A small lending library on SQLite with Prisma: schema, migrations, a seed and queries, behind an Express API (KnYC golden fixture).",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
